<?xml version="1.0" encoding="UTF-8"?>
<iStarX xmlns="urn:istarx:grammar:v1.0">

  <header title="Meeting Scheduling Domain"
          author="user"
          source="hand-authored example"
          lastUpdated="2026-07-26">
    A simple meeting-scheduling domain: one actor collects constraints
    from participants (by email or poll) and identifies a slot.
  </header>

  <options continuous="false" infeasibleActionPenalty="-100"/>

  <actors>
    <actor name="ms" description="Meeting Scheduler">
      <goals>

        <goal name="haveMeetingScheduled" mode="achieve" root="true" actor="ms">
          <parameters>
            <parameter><paramType>actor</paramType><paramName>ms</paramName></parameter>
            <parameter><paramType>meeting</paramType><paramName>m</paramName></parameter>
          </parameters>
          <refinement type="AND">
            <goalRef name="collectConstraints">
              <parameters>
                <parameter><paramType>actor</paramType><paramName>ms</paramName></parameter>
                <parameter><paramType>meeting</paramType><paramName>m</paramName></parameter>
              </parameters>
            </goalRef>
            <taskRef name="identifySlot">
              <parameters>
                <parameter><paramType>actor</paramType><paramName>ms</paramName></parameter>
                <parameter><paramType>meeting</paramType><paramName>m</paramName></parameter>
              </parameters>
            </taskRef>
          </refinement>
        </goal>

        <goal name="collectConstraints" mode="achieve" actor="ms">
          <parameters>
            <parameter><paramType>actor</paramType><paramName>ms</paramName></parameter>
            <parameter><paramType>meeting</paramType><paramName>m</paramName></parameter>
          </parameters>
          <refinement type="OR">
            <goalRef name="collectConstraintsByEmail">
              <parameters>
                <parameter><paramType>actor</paramType><paramName>ms</paramName></parameter>
                <parameter><paramType>meeting</paramType><paramName>m</paramName></parameter>
              </parameters>
            </goalRef>
            <taskRef name="collectConstraintsByPoll">
              <parameters>
                <parameter><paramType>actor</paramType><paramName>ms</paramName></parameter>
                <parameter><paramType>meeting</paramType><paramName>m</paramName></parameter>
              </parameters>
            </taskRef>
          </refinement>
        </goal>

        <goal name="collectConstraintsByEmail" mode="achieve" actor="ms">
          <parameters>
            <parameter><paramType>actor</paramType><paramName>ms</paramName></parameter>
            <parameter><paramType>meeting</paramType><paramName>m</paramName></parameter>
          </parameters>
          <refinement type="AND">
            <ref-condition>
              <forall>
                <params>
                  <param>p</param>
                </params>
                <condition>
                  <predicate name="pp">
                    <parameters>
                      <parameter><paramType>participant</paramType><paramName>p</paramName></parameter>
                    </parameters>
                  </predicate>
                </condition>
              </forall>
            </ref-condition>
            <taskRef name="collectIndividualConstraints">
              <parameters>
                <parameter><paramType>actor</paramType><paramName>ms</paramName></parameter>
                <parameter><paramType>participant</paramType><paramName>p</paramName></parameter>
                <parameter><paramType>meeting</paramType><paramName>m</paramName></parameter>
              </parameters>
            </taskRef>
          </refinement>
        </goal>

      </goals>

      <tasks>

        <task name="identifySlot" actor="ms">
          <parameters>
            <parameter><paramType>actor</paramType><paramName>ms</paramName></parameter>
            <parameter><paramType>meeting</paramType><paramName>m</paramName></parameter>
          </parameters>
          <effectGroup>
            <effect name="identifySlotSucc" satisfying="true" probability="0.9">
              <turnsTrue>
                <predicate name="slotIdentified">
                  <parameters>
                    <parameter><paramType>meeting</paramType><paramName>m</paramName></parameter>
                  </parameters>
                </predicate>
              </turnsTrue>
            </effect>
            <effect name="identifySlotFail" satisfying="false" probability="0.1"/>
          </effectGroup>
        </task>

        <task name="collectConstraintsByPoll" actor="ms">
          <parameters>
            <parameter><paramType>actor</paramType><paramName>ms</paramName></parameter>
            <parameter><paramType>meeting</paramType><paramName>m</paramName></parameter>
          </parameters>
          <effectGroup>
            <effect name="collectConstraintsByPollSucc" satisfying="true" probability="0.9">
              <turnsTrue>
                <predicate name="constraintsCollected">
                  <parameters>
                    <parameter><paramType>meeting</paramType><paramName>m</paramName></parameter>
                  </parameters>
                </predicate>
              </turnsTrue>
            </effect>
            <effect name="collectConstraintsByPollFail" satisfying="false" probability="0.1"/>
          </effectGroup>
        </task>

        <task name="collectIndividualConstraints" actor="ms">
          <parameters>
            <parameter><paramType>actor</paramType><paramName>ms</paramName></parameter>
            <parameter><paramType>participant</paramType><paramName>p</paramName></parameter>
            <parameter><paramType>meeting</paramType><paramName>m</paramName></parameter>
          </parameters>
          <effectGroup>
            <effect name="collectIndividualConstraintsSucc" satisfying="true" probability="1.0">
              <turnsTrue>
                <predicate name="invitee">
                  <parameters>
                    <parameter><paramType>participant</paramType><paramName>p</paramName></parameter>
                  </parameters>
                </predicate>
              </turnsTrue>
            </effect>
            <effect name="collectIndividualConstraintsFail" satisfying="false" probability="0.0"/>
          </effectGroup>
        </task>

      </tasks>
    </actor>
  </actors>

  <predicates>
    <predicate name="pp" description="Is a potential participant for the meeting">
      <parameters>
        <parameter><paramType>participant</paramType><paramName>p</paramName></parameter>
      </parameters>
    </predicate>
    <predicate name="important" description="Is an important participant">
      <parameters>
        <parameter><paramType>participant</paramType><paramName>p</paramName></parameter>
      </parameters>
    </predicate>
    <predicate name="invitee" description="Has been invited / had constraints collected">
      <parameters>
        <parameter><paramType>participant</paramType><paramName>p</paramName></parameter>
      </parameters>
    </predicate>
    <predicate name="constraintsCollected" description="Constraints have been collected for the meeting">
      <parameters>
        <parameter><paramType>meeting</paramType><paramName>m</paramName></parameter>
      </parameters>
    </predicate>
    <predicate name="slotIdentified" description="A slot has been identified for the meeting">
      <parameters>
        <parameter><paramType>meeting</paramType><paramName>m</paramName></parameter>
      </parameters>
    </predicate>
  </predicates>

  <initializations>
    <boolInit value="true">
      <predicate name="pp">
        <parameters>
          <parameter><paramType>participant</paramType><paramName>alice</paramName></parameter>
        </parameters>
      </predicate>
    </boolInit>
    <boolInit value="true">
      <predicate name="pp">
        <parameters>
          <parameter><paramType>participant</paramType><paramName>bob</paramName></parameter>
        </parameters>
      </predicate>
    </boolInit>
    <boolInit value="true">
      <predicate name="pp">
        <parameters>
          <parameter><paramType>participant</paramType><paramName>christie</paramName></parameter>
        </parameters>
      </predicate>
    </boolInit>
    <boolInit value="true">
      <predicate name="important">
        <parameters>
          <parameter><paramType>participant</paramType><paramName>alice</paramName></parameter>
        </parameters>
      </predicate>
    </boolInit>
    <boolInit value="true">
      <predicate name="important">
        <parameters>
          <parameter><paramType>participant</paramType><paramName>bob</paramName></parameter>
        </parameters>
      </predicate>
    </boolInit>
  </initializations>

  <definitions>
    <definition>
      <definiendum name="ip">
        <parameters>
          <parameter><paramType>participant</paramType><paramName>p</paramName></parameter>
        </parameters>
      </definiendum>
      <definiens>
        <and>
          <predicate name="pp">
            <parameters>
              <parameter><paramType>participant</paramType><paramName>p</paramName></parameter>
            </parameters>
          </predicate>
          <predicate name="important">
            <parameters>
              <parameter><paramType>participant</paramType><paramName>p</paramName></parameter>
            </parameters>
          </predicate>
        </and>
      </definiens>
    </definition>
  </definitions>

</iStarX>