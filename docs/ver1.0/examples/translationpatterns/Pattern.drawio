        <object label="pick(ca).pollingAgent(pa)" concept="orDecomp" id="pAowDUD0oEhH17143uuC-5">
          <mxCell edge="1" parent="1" source="pAowDUD0oEhH17143uuC-4" style="orthogonalLoop=1;jettySize=auto;html=1;fontSize=15;endArrow=open;endFill=0;endSize=17;strokeColor=#000000;curved=1;rounded=0;" target="pAowDUD0oEhH17143uuC-12">
